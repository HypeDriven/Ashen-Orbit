{"msg.0b5d4e5849395a53":"தானியங்கி துப்பாக்கி","msg.2aac581db9eb51dc":"மலிவான சமநிலையான குண்டுகள்; வரையறுக்கப்பட்ட வரம்பு.","msg.a646250fde5e56b2":"கதிர் லேசர்","msg.538e4a92d325b55a":"உடனடி துல்லியமான கதிர்; உயர் கடன்சார் வடிகட்டுதல்.","msg.d79895021e484269":"துடிப்பு லேசர்","msg.7f0c16e9e61b13d9":"வேகமான ஒளி மின்னல்கள்; மோசமான கவச சேதம்.","msg.3c431303573744c0":"சீர்குலைப்பான்","msg.5e85a70d421dff94":"3x கவசம் சேதம்; வெற்று சரக்கு எதிராக பலவீனமான.","msg.72e3782352b59f32":"அயன் ப்ரொஜெக்டர்","msg.13dfaa53ca9acb45":"எதிரியின் ஆயுதங்களை தடுக்கிறது மற்றும் இயக்கிகளை மெதுவாக்குகிறது; குறைந்த சேதம்.","msg.3d8339e1024c4616":"வழிநடத்தும் ஏவுகணைகள்","msg.f69f6201d66be0b6":"இலக்கு தேர்ந்தெடுக்கப்பட்டது; மெதுவாக திருப்புதல், நீண்ட மறுசீரமைப்பு.","msg.79768d98edb0c07f":"இயங்காத ராக்கெட்டுகள்","msg.f4c6efbb5ee77913":"வேகமான வெடிப்பு சால்வோ; வெடிப்பு உங்கள் கப்பலை சேதப்படுத்தலாம்.","msg.57c2713e7dc59212":"துகள்கள் ஏவுகணை","msg.49571cd526c69add":"மூன்று கப்பல்கள் துளைக்கிறது; அதிக வெப்பம் மற்றும் சக்தி சுமை.","msg.a47cb4967170c9ed":"ரயில் துப்பாக்கி","msg.581c2c8fcc483d44":"தீவிர தூரம், கவசம் துளைத்தல்; மிகவும் மெதுவான மறுசீரமைப்பு.","msg.67924ad6de7f5ad3":"பிளாஸ்மா மோட்டார்","msg.67b46c00bd30de5d":"பெரிய வெடிப்பு; மெதுவான புள்ளிகள் எளிதில் ஓடிவிடும்.","msg.92b2bbbf4930d8c7":"ஃப்ளாக் பேட்டரி","msg.011ad47fd49737d1":"ஏழு துண்டுகள் கும்பல்களை தண்டிக்கின்றன; மோசமான தூர துல்லியம்.","msg.3911ebde797e8ab9":"சுழலும் துப்பாக்கி","msg.08a459bb4d9a87fd":"மலிவான வேகமான அடக்கும் தீ; பரவல் மற்றும் வெப்பம் வேகமாக உருவாக்கப்படுகிறது.","msg.b9e527be8c26bc57":"வில் சுருள்","msg.6b16b119d5015593":"மூன்று அருகிலுள்ள எதிரிகள் சங்கிலிகள்; மிக குறுகிய எல்லை.","msg.d8439d6bbfcff4b3":"தெர்மைட் ஜெட்","msg.b1e3af27486aea3e":"காலப்போக்கில் சரக்கு எரிகிறது; ஆபத்தான நெருங்கிய அணுகுமுறை தேவைப்படுகிறது.","msg.b54a6eb4c5a6a5ae":"அருகிலுள்ள சுரங்கங்கள்","msg.96b8d98c120130cb":"நிலையான பகுதியில் மறுப்பு; ஒரு வினாடி ஆயுதம் தாமதம்.","msg.5ba121c52b71384a":"எதிர் பொருள் டார்பெடோ","msg.43e95a78ebd0a24d":"மிகப்பெரிய போர்முனை; மெதுவான, அதிக வடிகட்டி, மற்றும் ஆபத்தான வெடிப்பு.","msg.baf260d40e2f0a73":"சிப்பன் பீம்","msg.88c47c995d1b6c59":"20% படகுத் தளத்தின் சேதத்தை சரிசெய்கிறது; விலை உயர்ந்த குறைந்த DPS.","msg.13ff40bdb8ec64e1":"சுருள் மறுபதிப்பு","msg.4677962d55db5f19":"வேகமான துல்லியமான ஊசிகள் இரண்டாவது கப்பலை துளைக்கின்றன; பலவீனமான கவசங்கள்.","msg.f91bcb2674f8f03c":"ஹெலிக்ஸ் ப்ரொஜெக்டர்","msg.1cb04007309801ab":"இரட்டை நெசவு திருகுகள் விரிவடையும் பாதையை உள்ளடக்குகின்றன; மிதமான வரம்பு.","msg.68e498986082a667":"தேடல் கூட்டம்","msg.d18b28a7514b4ae3":"மூன்று சுறுசுறுப்பான தேடுபவர்கள் அருகிலுள்ள இலக்குகளை அடைகிறார்கள்; குறைந்த துருப்பு சேதம்.","msg.fd13b3a510176a1a":"குண்டு குண்டு","msg.1457b33d8d8ca3e4":"0.7s பிறகு பிளவுபடுகிறது அல்லது எட்டு குறுகிய தூர துண்டுகளாக தாக்க.","msg.1e80b8a4d3328de9":"உடைப்பு டார்பெடோ","msg.72407e974b6cc466":"தளங்கள் மற்றும் முன்னணி தளங்களுக்கு 3x சேதம்; படகுகளுக்கு எதிராக மெதுவாகவும் மோசமாகவும்.","msg.82f8b053e4d69474":"சண்டை வீரர் வெடிப்பு","msg.952ee86d2005fd61":"ஒளி-முனையில் மூன்று வெடிப்பு; நெருக்கமான மற்றும் பரந்த பரவல்.","msg.038908d55af5733f":"கப்பல் ஏவுகணை","msg.d024a171a91df94c":"ஃப்ரிகேட் அணு உலை ஊட்டப்பட்ட கதிர்; நீண்ட தூரம், கனமான கடத்தி வடிகட்டுதல்.","msg.222cfd493b0cff29":"தலைநகர எதிர்ப்பு அலைவரிசை","msg.0c9c344b227fe898":"தலைநகரம் கும்பல் பாதுகாப்பு; ஒன்பது குண்டுகள், அதிக வெப்பம் மற்றும் சக்தி.","msg.e50f7db18c4e4643":"முற்றுகை ஈட்டி","msg.ecdfb3b6e275c37a":"ட்ரெட்னவுட் கதிர்; 1.8x கட்டமைப்பு சேதம், மிகவும் மெதுவான மறுசீரமைப்பு.","msg.e15f88dcd76f8f2d":"ரேடியேட்டர்","msg.1651da4eb6111853":"+14 வெப்ப குளிரூட்டல்/விநாடி.","msg.b3abbf22b5be6b1f":"மீட்பு வின்ச்","msg.e408ea1405619b36":"+140 டிராக்டர் வரம்பு; -10% வேகம்.","msg.a8df2a6fecf352df":"கனமான தடுப்பு","msg.16e7882b36edf2f9":"+110 சரக்கு; -8% வேகம்.","msg.02d79073cdb60151":"சுரங்க ட்ரோன் பே","msg.ce3f094e37d4840e":"2 சுரங்கத் தொழிலாளர்கள் கற்களைத் துடைத்து, தாதுவைச் சேகரித்து அதைத் திருப்பித் தருகிறார்கள். 2 கப்பல் DPS ஒவ்வொரு.","msg.c88547ad0a3a6ae7":"கண்காணிப்பு ட்ரோன் ஏரி","msg.938